# Copy this file to `.env` and fill in your key. Never commit the real .env file.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your_gemini_api_key>

# Without this key set, the app runs in offline "mock mode": the full pipeline
# (frame extraction -> mock frame descriptions -> mock summary) still runs so
# you can verify the plumbing, but descriptions/summaries are placeholders.
